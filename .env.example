NODE_ENV=development
HOST=127.0.0.1
PORTAL_VERSION=1.1.4
LORE_VERSION=0.14.0
APP_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
LORE_GRPC_URL=localhost:41337
LORE_HTTP_URL=http://localhost:41339
LORE_PUBLIC_URL=lore://localhost:3000
LORE_INTERNAL_URL=lore://localhost:41337
WEB_INTERNAL_PORT=41340
PUBLIC_GATEWAY_PORT=3000
LORE_RUNTIME_CONFIG_PATH=./data/local/config/local.toml
LORE_STORAGE_PATH=./data/local/lore
LORE_QUIC_TLS_CERT_FILE=./data/local/certs/lore.crt
LORE_QUIC_TLS_KEY_FILE=./data/local/certs/lore.key
LORE_SUPERVISOR_PID_FILE=./data/local/run/lore-supervisor.pid
LORE_SUPERVISOR_SOCKET=./data/local/run/lore-supervisor.sock
LORE_CLI_PATH=./data/local/bin/lore
LORE_IMPORT_WORK_DIR=./data/local/imports
LORE_IMPORT_MAX_SOURCE_BYTES=0
LORE_IMPORT_GIT_USERNAME=oauth2
GIT_PATH=git
LORE_TLS=false
LORE_AUDIENCE=lore-portal
GRPC_HOST=0.0.0.0
