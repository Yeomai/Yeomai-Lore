DATABASE_PATH=./data/local/portal.sqlite
SESSION_TTL_SECONDS=604800
ACCESS_TOKEN_TTL_SECONDS=86400
REPOSITORY_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=7776000
OIDC_KEY_DIR=./data/keys
