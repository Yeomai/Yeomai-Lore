# Unity 项目忽略规则
#
# 保留：Assets/、Packages/、ProjectSettings/ 和所有 *.meta 文件。
# 忽略：导入缓存、构建目录、日志、用户设置和 IDE 生成文件。

# Unity 自动生成的目录
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Ee]xported[Oo]bj/

# Unity 本地导入和缓存
*.pidb
*.pidb.meta
*.pdb
*.mdb
*.opendb
*.VC.db
*.svd
*.booproj
*.unityproj
*.tmp
*.userprefs
*.unitypackage.meta
sysinfo.txt
crashlytics-build.properties

# Android 和原生构建缓存
.gradle/
.externalNativeBuild/
.cxx/

# IDE 和自动生成的项目文件
.vs/
.vsconfig
.idea/
.vscode/
.consulo/
*.csproj
*.sln
*.slnx
*.suo
*.user

# 日志、崩溃报告和临时文件
*.log
*.dmp
*.stackdump
*.bak
*.swp
*~

# macOS 系统元数据和 Finder 索引
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
.fseventsd/
.TemporaryItems/
.DocumentRevisions-V100/
.apdisk

# Windows 系统元数据
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.lnk

# Linux 桌面元数据
.directory
