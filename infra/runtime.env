# Other values are authoritative. LORE_VERSION is synchronized from each image.
PORTAL_VERSION=1.1.4
LORE_VERSION=0.14.0
APP_PUBLIC_URL=http://localhost:3000
LORE_PUBLIC_URL=lore://localhost:3000
LORE_INTERNAL_URL=lore://localhost:41337
WEB_INTERNAL_PORT=41340
PUBLIC_GATEWAY_PORT=3000
LORE_RUNTIME_CONFIG_PATH=/data/config/local.toml
LORE_STORAGE_PATH=/data/lore/store
LORE_QUIC_TLS_CERT_FILE=/certs/lore.crt
LORE_QUIC_TLS_KEY_FILE=/certs/lore.key
LORE_SUPERVISOR_PID_FILE=/data/run/lore-supervisor.pid
LORE_SUPERVISOR_SOCKET=/data/run/lore-supervisor.sock
ACCESS_TOKEN_TTL_SECONDS=86400

SMTP_URL=
SMTP_FROM="Yeomai Lore <noreply@example.com>"
